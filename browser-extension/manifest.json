{
  "manifest_version": 3,
  "name": "Copybara",
  "version": "1.0.0",
  "description": "Парсинг статей в Copybara одним кликом. Откройте страницу — нажмите «Спарсить» — контент отправится в AI-редактор для переписывания.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copybara@copybara.ai",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
